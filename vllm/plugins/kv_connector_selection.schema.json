{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vllm-hust.sage.org.ai/schemas/kv-connector-selection-v1.schema.json",
  "title": "vLLM KV connector selection topology v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "composition", "connectors"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "composition": {"enum": ["single", "ordered_multi"]},
    "connectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "connector_id",
          "scheduler_component",
          "worker_component",
          "telemetry_component",
          "scheduler_capabilities",
          "worker_capabilities"
        ],
        "properties": {
          "connector_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*$"
          },
          "scheduler_component": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9.-]*$"
          },
          "worker_component": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9.-]*$"
          },
          "telemetry_component": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9.-]*$"
          },
          "scheduler_capabilities": {
            "type": "object",
            "additionalProperties": false,
            "required": ["supports_hma"],
            "properties": {
              "supports_hma": {"type": "boolean"}
            }
          },
          "worker_capabilities": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "supports_hma",
              "requires_piecewise_for_cudagraph",
              "required_kv_cache_layout"
            ],
            "properties": {
              "supports_hma": {"type": "boolean"},
              "requires_piecewise_for_cudagraph": {"type": "boolean"},
              "required_kv_cache_layout": {
                "type": ["string", "null"],
                "enum": ["NHD", "HND", null]
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"composition": {"const": "single"}}},
      "then": {"properties": {"connectors": {"minItems": 1, "maxItems": 1}}}
    },
    {
      "if": {"properties": {"composition": {"const": "ordered_multi"}}},
      "then": {"properties": {"connectors": {"minItems": 2}}}
    }
  ]
}
