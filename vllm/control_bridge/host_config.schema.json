{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vllm-hust.sage.org.ai/schemas/control-bridge-host-v1.schema.json",
  "title": "vLLM-HUST local control bridge host configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runtime_id", "epoch", "state_version", "socket_path", "replay_ledger_path", "granted_scopes", "key_set"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "runtime_id": {"type": "string", "minLength": 1},
    "epoch": {"type": "integer", "minimum": 0},
    "state_version": {"type": "integer", "minimum": 0},
    "socket_path": {"type": "string", "minLength": 1},
    "replay_ledger_path": {"type": "string", "minLength": 1},
    "granted_scopes": {"const": ["runtime.read"]},
    "key_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "keys"],
      "properties": {
        "generation": {"type": "integer", "minimum": 0},
        "keys": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["issuer", "key_id", "secret_file", "not_before"],
            "properties": {
              "issuer": {"type": "string", "minLength": 1},
              "key_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
              "secret_file": {"type": "string", "minLength": 1},
              "not_before": {"type": "string", "format": "date-time"},
              "not_after": {"type": "string", "format": "date-time"},
              "revoked_at": {"type": "string", "format": "date-time"}
            }
          }
        }
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "max_in_flight": {"type": "integer", "minimum": 1, "maximum": 64},
        "read_timeout": {"type": "number", "exclusiveMinimum": 0, "maximum": 300},
        "health_timeout": {"type": "number", "exclusiveMinimum": 0, "maximum": 300},
        "service_timeout": {"type": "number", "exclusiveMinimum": 0, "maximum": 300},
        "shutdown_timeout": {"type": "number", "exclusiveMinimum": 0, "maximum": 300},
        "executor_startup_timeout": {"type": "number", "exclusiveMinimum": 0, "maximum": 300},
        "executor_request_timeout": {"type": "number", "exclusiveMinimum": 0, "maximum": 300},
        "executor_shutdown_timeout": {"type": "number", "exclusiveMinimum": 0, "maximum": 300}
      }
    }
  }
}
